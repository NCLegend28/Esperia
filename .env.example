# Copy to .env.dev. Production and staging remain disabled in milestone 1.
APP_ENV=dev
ESPERIA_DATABASE=.local/dev/jobs.sqlite
ESPERIA_MONTHLY_CENTS=6500
ESPERIA_JOB_CENTS=500
# Research uses the saved Codex ChatGPT login; no API key is required.
# Optional absolute path when Codex is installed elsewhere:
# ESPERIA_CODEX_BIN=/absolute/path/to/codex

# Optional local runtime settings. Existing Ollama models only; no auto-download.
ESPERIA_OLLAMA_URL=http://127.0.0.1:11434
ESPERIA_OLLAMA_MODEL=qwen2.5:7b
ESPERIA_OLLAMA_CONTEXT=32768
# For a separately running llama.cpp server:
ESPERIA_LLAMA_URL=http://127.0.0.1:8080
# ESPERIA_LLAMA_MODEL=your-server-model-alias

# Local models can spend several minutes reading long prompts and generating JSON.
ESPERIA_OLLAMA_TIMEOUT_SECONDS=900

# Optional public configuration file (absolute path recommended):
# ESPERIA_CONFIG=/absolute/path/to/esperia.json
# Relocate database, evidence, research and cache together:
# ESPERIA_DATA_ROOT=/absolute/path/to/esperia-data
# Remove ESPERIA_DATABASE above if you want the database derived from data_root.
